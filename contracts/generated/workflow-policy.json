{
  "schemaVersion": "workflow-policy-v1",
  "version": "7.0.0",
  "sourceOfTruth": {
    "skill": "SKILL.md",
    "design": "DESIGN.md",
    "contractsDir": "contracts/"
  },
  "bestEffectBrief": {
    "required": true,
    "recordFields": [
      "promptQuality",
      "autoExpandedAssumptions",
      "recommendedRoute",
      "decisionProvenance"
    ]
  },
  "routing": {
    "askBeforeGenerate": false,
    "askOnlyWhenMateriallyAmbiguous": true,
    "maxUserFacingQuestions": 3,
    "rules": [
      {
        "id": "explicit-edit-signal",
        "priority": 5,
        "route": "preserve-edit",
        "qualityMode": "standard",
        "signals": [
          "改PPT",
          "修改PPT",
          "修PPT",
          "保真修改",
          "改这份PPT",
          "edit this pptx",
          "revise this deck",
          "fix my slides",
          "repair the pptx",
          "调整这几页",
          "只改第"
        ]
      },
      {
        "id": "explicit-formal-signal",
        "priority": 10,
        "route": "editable-deck",
        "qualityMode": "standard",
        "signals": [
          ".pptx",
          "pptx",
          "PowerPoint",
          "可编辑",
          "汇报",
          "报告",
          "政府",
          "金融",
          "培训",
          "审计",
          "consulting",
          "business report",
          "board deck",
          "editable",
          "stakeholder",
          "training",
          "government",
          "finance",
          "audit"
        ]
      },
      {
        "id": "explicit-web-signal",
        "priority": 20,
        "route": "web-deck",
        "qualityMode": "standard",
        "signals": [
          "HTML",
          "web PPT",
          "网页",
          "magazine",
          "editorial",
          "e-ink",
          "电子墨水",
          "Swiss",
          "横滑",
          "keynote",
          "showcase",
          "demo-day",
          "browser-first"
        ]
      },
      {
        "id": "extreme-thin-fallback",
        "priority": 90,
        "route": "editable-deck",
        "qualityMode": "standard",
        "when": {
          "promptQuality": "extreme-thin",
          "noFormalSignal": true,
          "noWebSignal": true
        },
        "defaults": {
          "mode": "Editable Deck",
          "style": "正式商务 PPTX / 微软雅黑 / 可编辑正文",
          "pages": 6,
          "coverSurface": "light-or-warm-paper",
          "pageRhythm": [
            "light or warm-paper cover with one strong title, minimal subtitle, and one soft-edged visual/evidence panel",
            "context page for problem, trend, or setting",
            "evidence / data page with source-bound claims",
            "comparison or process page",
            "risk or action page",
            "light closing page with takeaway and next step"
          ]
        }
      }
    ]
  },
  "visualDefaults": {
    "defaultCoverSurface": "light-or-warm-paper",
    "allowDarkCoverOnlyWhen": [
      "user",
      "brand",
      "explicit-art-direction"
    ],
    "inkIsTextColorNotDefaultBackground": true,
    "formalPptxDefaultCover": "light-or-near-white",
    "forbidFullPageBlackCoverByDefault": true
  },
  "sourceImport": {
    "defaultMode": "copy",
    "allowMove": true,
    "moveFlag": "--move",
    "copyFlag": "--copy",
    "archiveAndRemoveOriginalFlag": "--archive-and-remove-original",
    "repoInternalDefault": "move",
    "userFacingDefault": "copy"
  },
  "evidenceStates": {
    "allowed": [
      "unmapped",
      "candidate",
      "grounded",
      "conflicted",
      "missing"
    ],
    "draftWithReadySources": "unmapped",
    "groundedRequiresClaimBinding": true,
    "neverGroundFromSourcePresenceAlone": true
  },
  "qualityModes": {
    "default": "standard",
    "available": [
      "quick",
      "standard",
      "audit"
    ],
    "formalDefault": "standard",
    "boardGovernmentFinanceExternal": "audit"
  },
  "agentEntryFragments": {
    "generate": [
      "AGENTS.md",
      "CLAUDE.md",
      "PROMPT.md"
    ],
    "skillSections": [
      "best-effect-brief",
      "extreme-thin-fallback",
      "source-import",
      "quality-modes"
    ],
    "runtimeArtifacts": [
      "packages/workspace-core/src/generated/policy.ts",
      "scripts/generated/policy.py",
      "contracts/generated/route-policy.json"
    ]
  }
}
