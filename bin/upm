#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PYTHON=""
for candidate in \
  "$ROOT_DIR/.venv/bin/python" \
  "$ROOT_DIR/.venv/Scripts/python.exe" \
  "$ROOT_DIR/.venv/Scripts/python" \
  python3.13 python3.12 python3.11 python3.10 python; do
  if [[ -x "$candidate" ]] || command -v "$candidate" >/dev/null 2>&1; then
    if [[ "$candidate" == */* ]]; then
      PYTHON="$candidate"
    else
      PYTHON="$(command -v "$candidate")"
    fi
    break
  fi
done

if [[ -z "$PYTHON" ]]; then
  echo "[upm] 需要 Python 3.10+。请运行: bash scripts/bootstrap.sh --profile core" >&2
  exit 1
fi

exec "$PYTHON" -m upm "$@"
